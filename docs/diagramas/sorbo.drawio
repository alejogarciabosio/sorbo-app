        <mxCell id="l_repo" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="90" as="sourcePoint"/><mxPoint x="555" y="800" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="h_room" value="&lt;b&gt;Room&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="130" height="50" as="geometry"/></mxCell>
        <mxCell id="l_room" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="705" y="90" as="sourcePoint"/><mxPoint x="705" y="800" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="h_wk" value="&lt;b&gt;SyncWorker (WorkManager)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="790" y="40" width="130" height="50" as="geometry"/></mxCell>
        <mxCell id="l_wk" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="855" y="90" as="sourcePoint"/><mxPoint x="855" y="800" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="h_sb" value="&lt;b&gt;Supabase (Postgrest, Storage, Edge Function)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="940" y="40" width="130" height="50" as="geometry"/></mxCell>
        <mxCell id="l_sb" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1005" y="90" as="sourcePoint"/><mxPoint x="1005" y="800" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="h_gq" value="&lt;b&gt;Groq&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1090" y="40" width="130" height="50" as="geometry"/></mxCell>
        <mxCell id="l_gq" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1155" y="90" as="sourcePoint"/><mxPoint x="1155" y="800" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ph1" value="A · Guardado local (funciona con o sin conexión)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=none;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="1190" height="24" as="geometry"/></mxCell>
        <mxCell id="ph2" value="B · Al recuperar conexión (en segundo plano, aunque la app esté cerrada)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=none;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="384" width="1190" height="24" as="geometry"/></mxCell>
        <mxCell id="m1" value="1. onGuardar(formulario)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105" y="145" as="sourcePoint"/><mxPoint x="255" y="145" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" value="2. invoke(datos)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="255" y="175" as="sourcePoint"/><mxPoint x="405" y="175" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3" value="3. guardar(vino, degustacion)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405" y="240" as="sourcePoint"/><mxPoint x="555" y="240" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4" value="4. insert Vino + Degustacion, syncState = PENDIENTE" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="265" as="sourcePoint"/><mxPoint x="705" y="265" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5" value="5. encolar sincronización (requiere red)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="295" as="sourcePoint"/><mxPoint x="855" y="295" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6" value="6. Flow emite el diario actualizado" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;dashed=1;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="705" y="325" as="sourcePoint"/><mxPoint x="255" y="325" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m7" value="7. UiState: &quot;Vino guardado en tu diario&quot;" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;dashed=1;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="255" y="355" as="sourcePoint"/><mxPoint x="105" y="355" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m8" value="8. lee registros pendientes" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="855" y="425" as="sourcePoint"/><mxPoint x="705" y="425" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m9" value="9. upsert vino/degustacion + sube foto a Storage" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="855" y="455" as="sourcePoint"/><mxPoint x="1005" y="455" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m10" value="10. invoke analizar-etiqueta(foto)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="855" y="485" as="sourcePoint"/><mxPoint x="1005" y="485" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m11" value="11. imagen + prompt (API key solo en servidor)" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1005" y="515" as="sourcePoint"/><mxPoint x="1155" y="515" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m12" value="12. JSON {nombre, bodega, cepa, año}" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;dashed=1;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1155" y="545" as="sourcePoint"/><mxPoint x="1005" y="545" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m13" value="13. sugerencia" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;dashed=1;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1005" y="575" as="sourcePoint"/><mxPoint x="855" y="575" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m14" value="14. guarda SugerenciaIA, syncState = SINCRONIZADO" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="855" y="605" as="sourcePoint"/><mxPoint x="705" y="605" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m15" value="15. Flow emite el cambio" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;dashed=1;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="705" y="635" as="sourcePoint"/><mxPoint x="255" y="635" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m16" value="16. muestra &quot;La IA leyó la etiqueta&quot; para revisar" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;dashed=1;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="255" y="665" as="sourcePoint"/><mxPoint x="105" y="665" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="nv" value="Valida: nombre y opinión obligatorios; si el vino existe, agrega la degustación." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="415" y="184" width="200" height="30" as="geometry"/></mxCell>
        <mxCell id="n1" value="&lt;b&gt;Sin conexión:&lt;/b&gt; la fase B no se ejecuta y el registro queda PENDIENTE; la UI nunca espera a la red. &lt;b&gt;Si falla:&lt;/b&gt; WorkManager reintenta con backoff exponencial. &lt;b&gt;Con conexión al registrar:&lt;/b&gt; el ViewModel invoca SugerirDatosDesdeFoto, que hace los pasos 10 a 13 desde el formulario antes de guardar. &lt;b&gt;Lectura:&lt;/b&gt; la UI siempre lee de Room (fuente de verdad) mediante Flow." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="1190" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="topologia" name="Topología de infraestructura">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="dev" value="DISPOSITIVO ANDROID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="300" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="App Sorbo&lt;br&gt;(Kotlin + Jetpack Compose)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="240" height="60" as="geometry"/>
