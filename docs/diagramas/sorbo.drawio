  <diagram id="datos" name="Modelo de datos">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tt" value="Sorbo — Modelo de datos" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="usr" value="&lt;b&gt;Usuario&lt;/b&gt;&lt;hr&gt;id: UUID (PK, = Supabase Auth)&lt;br&gt;email: String&lt;br&gt;nombre: String&lt;br&gt;creadoEn: Instant" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="vino" value="&lt;b&gt;Vino&lt;/b&gt;&lt;hr&gt;id: UUID (PK)&lt;br&gt;usuarioId: UUID? (FK → Usuario)&lt;br&gt;nombre: String&lt;br&gt;nombreNormalizado: String (índice)&lt;br&gt;bodega: String?&lt;br&gt;cepa: String?&lt;br&gt;anio: Int?&lt;br&gt;fotoPath: String? (local)&lt;br&gt;fotoUrl: String? (Storage)&lt;br&gt;estadoAnalisis: SIN_FOTO | PENDIENTE | ANALIZADO | ERROR&lt;br&gt;creadoEn, actualizadoEn: Instant&lt;br&gt;syncState: PENDIENTE | SINCRONIZADO&lt;br&gt;eliminado: Boolean" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="50" width="320" height="300" as="geometry" />
        </mxCell>
        <mxCell id="deg" value="&lt;b&gt;Degustacion&lt;/b&gt;&lt;hr&gt;id: UUID (PK)&lt;br&gt;vinoId: UUID (FK → Vino)&lt;br&gt;fecha: LocalDate&lt;br&gt;meGusto: Boolean&lt;br&gt;dulzor: DULCE | SECO | null&lt;br&gt;comida: CARNE | PASTA | PESCADO | PIZZA | QUESOS | PICADA | POSTRE | SIN_COMIDA | OTRA&lt;br&gt;compania: SOLO | PAREJA | AMIGOS | FAMILIA | TRABAJO | OTRA&lt;br&gt;ocasion: CENA | ASADO | PREVIA | ALMUERZO | CELEBRACION | OTRA&lt;br&gt;nota: String?&lt;br&gt;actualizadoEn: Instant&lt;br&gt;syncState: PENDIENTE | SINCRONIZADO&lt;br&gt;eliminado: Boolean" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="820" y="50" width="330" height="300" as="geometry" />
        </mxCell>
        <mxCell id="sug" value="&lt;b&gt;SugerenciaIA&lt;/b&gt;&lt;hr&gt;id: UUID (PK)&lt;br&gt;vinoId: UUID (FK → Vino)&lt;br&gt;nombre, bodega, cepa: String?&lt;br&gt;anio: Int?&lt;br&gt;estado: PENDIENTE_REVISION | ACEPTADA | DESCARTADA&lt;br&gt;creadaEn: Instant" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="400" y="420" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ana" value="&lt;b&gt;AnalisisGustos&lt;/b&gt;&lt;hr&gt;id: UUID (PK)&lt;br&gt;usuarioId: UUID? (FK → Usuario)&lt;br&gt;resumen: String&lt;br&gt;sugerencias: List&amp;lt;String&amp;gt;&lt;br&gt;generadoEn: Instant&lt;br&gt;cantidadDegustaciones: Int" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="260" height="170" as="geometry" />
        </mxCell>
        <mxCell id="leg" value="&lt;b&gt;Dónde vive cada entidad&lt;/b&gt;&lt;br&gt;Azul: Room y Supabase (se sincroniza).&lt;br&gt;Verde: Supabase Auth + tabla perfiles; en el teléfono, la sesión activa.&lt;br&gt;Violeta: solo Room (datos derivados de la IA).&lt;br&gt;&lt;br&gt;En Supabase todas las tablas filtran por usuario_id con Row Level Security. Fotos en Storage: etiquetas/{usuario_id}/{vino_id}.jpg" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="420" width="330" height="170" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;" edge="1" parent="1" source="usr" target="vino">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmandOne;endArrow=ERoneToMany;startFill=0;endFill=0;" edge="1" parent="1" source="vino" target="deg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;" edge="1" parent="1" source="vino" target="sug">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;" edge="1" parent="1" source="usr" target="ana">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
