          <mxGeometry x="450" y="240" width="260" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="sfn" value="&lt;b&gt;Edge Functions&lt;/b&gt;&lt;br&gt;analizar-etiqueta · analizar-gustos&lt;br&gt;API key del LLM guardada como secret" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="450" y="315" width="260" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="llm" value="&lt;b&gt;Groq&lt;/b&gt;&lt;br&gt;LLM con visión (API compatible con OpenAI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="840" y="315" width="220" height="75" as="geometry"/>
