        <mxCell id="tnote" value="La app nunca se comunica directamente con el LLM: toda llamada de IA pasa por una Edge Function autenticada." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1">
