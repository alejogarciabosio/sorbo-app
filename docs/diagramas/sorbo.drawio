        <mxCell id="m16" value="16. muestra &quot;La IA leyó la etiqueta&quot; para revisar" style="html=1;verticalAlign=bottom;endArrow=block;fontSize=11;dashed=1;endFill=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="255" y="665" as="sourcePoint" />
            <mxPoint x="105" y="665" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="nv" value="Valida: nombre y opinión obligatorios; si el vino existe, agrega la degustación." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="415" y="184" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;Sin conexión:&lt;/b&gt; la fase B no se ejecuta y el registro queda PENDIENTE; la UI nunca espera a la red. &lt;b&gt;Si falla:&lt;/b&gt; WorkManager reintenta con backoff exponencial. &lt;b&gt;Con conexión al registrar:&lt;/b&gt; el ViewModel invoca SugerirDatosDesdeFoto, que hace los pasos 10 a 13 desde el formulario antes de guardar. &lt;b&gt;Lectura:&lt;/b&gt; la UI siempre lee de Room (fuente de verdad) mediante Flow." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="700" width="1190" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
