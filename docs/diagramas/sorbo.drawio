        <mxCell id="t2" value="HTTPS + API key&lt;br&gt;(solo servidor)" style="html=1;endArrow=block;startArrow=block;" edge="1" parent="1" source="sfn" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell>
