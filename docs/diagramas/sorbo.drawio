        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Resultado:&lt;/b&gt;&lt;br&gt;Ya lo probaste" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Detalle del vino&lt;/b&gt;&lt;br&gt;opiniones y veces probado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="180" height="60" as="geometry"/>
