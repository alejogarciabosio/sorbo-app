        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;Inicio / Historial&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="120" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="Escribe el nombre en el buscador" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
